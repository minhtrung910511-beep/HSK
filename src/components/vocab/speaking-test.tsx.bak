"use client";
import { useState, useCallback, useRef, useEffect } from "react";
import { motion } from "framer-motion";
import { Mic, MicOff, CheckCircle2, XCircle, RotateCcw, ChevronLeft, Trophy, Volume2, MessageCircle } from "lucide-react";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Progress } from "@/components/ui/progress";
import { useVocab } from "@/lib/vocab-context";
import { useAuth } from "@/hooks/use-auth";
type SM="repeat"|"answer"|"free";
type P="intro"|"playing"|"result";
interface SQ{mode:SM;prompt:string;promptP:string;promptVi:string;expectedAnswer:string;expectedPinyin:string;keywords?:string[];}
function sh<T>(a:T[]):T[]{const b=[...a];for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]];}return b;}
function sp(t:string){if(typeof window==="undefined"||!("speechSynthesis"in window))return;const u=new SpeechSynthesisUtterance(t);u.lang="zh-CN";u.rate=0.9;const v=window.speechSynthesis.getVoices();const z=v.find(x=>x.lang.startsWith("zh"));if(z)u.voice=z;window.speechSynthesis.cancel();window.speechSynthesis.speak(u);}
function nt(s:string):string{return s.replace(/[\s，。！？、,.!?]/g,"").toLowerCase().trim();}
function ie(s:string,e:string):boolean{return nt(s)===nt(e);}
function genQ(v:any[]):SQ[]{const p=sh(v).slice(0,10);const ms:SM[]=["repeat","answer","free"];return p.map((w,i)=>{const mode=ms[i%3];const ex=w.example||`${w.han}。`;const exp=w.examplePinyin||`${w.pinyin}。`;const exv=w.exampleVi||w.meaning;if(mode==="repeat")return{mode:"repeat",prompt:ex,promptPinyin:exp,promptVi:exv,expectedAnswer:ex.replace(/[。！？]/g,""),expectedPinyin:exp};if(mode==="answer")return{mode:"answer",prompt:`${w.han}是什么意思？`,promptPinyin:`${w.pinyin} shì shénme yìsi？`,promptVi:`"${w.han}" nghĩa là gì?`,expectedAnswer:w.meaning,expectedPinyin:""};return{mode:"free",prompt:`请用"${w.han}"造一个句子`,promptPinyin:`qǐng yòng "${w.han}" zào yí ge jùzi`,promptVi:`Hãy dùng "${w.han}" (${w.meaning}) đặt 1 câu`,expectedAnswer:w.han,expectedPinyin:w.pinyin,keywords:[w.han]};});}
export function SpeakingTest(){
const VOCAB=useVocab();const{user,submitScore}=useAuth();const[Pf,setPf]=useState<P>("intro");const[qs,setQs]=useState<SQ[]>([]);const[cur,setCur]=useState(0);const[sc,setSc]=useState(0);const[rs,setRs]=useState<{c:boolean;s:string;e:string}[]>([]);
const[il,setIl]=useState(false);const[st,setSt]=useState("");const[hr,setHr]=useState(false);const rr=useRef<any>(null);
useEffect(()=>{if(typeof window==="undefined")return;const SR=(window as any).SpeechRecognition||(window as any).webkitSpeechRecognition;if(SR){const r=new SR();r.lang="zh-CN";r.continuous=false;r.interimResults=false;r.maxAlternatives=3;r.onresult=(e:any)=>{const l=e.results.length-1;setSt(e.results[l][0].transcript);setHr(true);setIl(false);};r.onerror=(e:any)=>{setIl(false);if(e.error==="not-allowed")setSt("__ERR__");};r.onend=()=>setIl(false);rr.current=r;}},[]);
const sl=useCallback(()=>{if(!rr.current)return;setSt("");setHr(false);setIl(true);try{rr.current.start();}catch{setIl(false);},[]);
const spl=useCallback(()=>{if(rr.current)rr.current.stop();setIl(false);},[]);
const st2=useCallback(()=>{setQs(genQ(VOCAB));setCur(0);setSc(0);setRs([]);setPf("playing");},[VOCAB]);
const ha=useCallback(()=>{if(!hr||!qs[cur])return;const q=qs[cur];let c=false;if(q.mode==="free"){c=q.keywords?.some(k=>nt(st).includes(nt(k)))||false;}else{c=ie(st,q.expectedAnswer);}if(c)setSc(s=>s+1);setRs(p=>[...p,{c,s:st,e:q.expectedAnswer}]);if(cur+1>=qs.length){setPf("result");if(user&&submitScore&&c)submitScore("flashcard_review",(sc+(c?1:0))*10,{speaking:true}).catch(()=>{});}else{setCur(c=>c+1);setSt("");setHr(false);}},[hr,qs,cur,st,sc,user,submitScore]);
if(Pf==="intro")return(<Card className="p-6 md:p-8 border-0 bg-gradient-to-br from-cyan-100 via-sky-50 to-blue-100"><div className="flex items-center gap-3 mb-4"><div className="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-500 flex items-center justify-center shadow-md"><MessageCircle className="h-6 w-6 text-white"/></div><div><h2 className="text-2xl font-bold">Kiểm tra giao tiếp</h2><p className="text-sm text-muted-foreground">Nói tiếng Trung → chấm điểm tự động</p></div></div><div className="space-y-3 mb-6"><div className="p-3 rounded-xl bg-white/70 border border-cyan-200"><div className="font-semibold text-sm mb-2">📋 3 dạng (10 câu)</div><ul className="text-xs text-muted-foreground space-y-2"><li>🔹 Nói theo mẫu - Nghe câu → nói lại chính xác</li><li>🔹 Trả lời câu hỏi - Hiện câu hỏi → nói trả lời</li><li>🔹 Tự do giao tiếp - Đặt câu với từ cho sẵn</li></ul></div><div className="p-3 rounded-xl bg-amber-50 border border-amber-200"><div className="font-semibold text-sm mb-1">🏆 Chấm điểm</div><p className="text-xs text-muted-foreground">Chính xác 100%. Mỗi câu = 10 điểm chăm chỉ.</p></div><div className="p-3 rounded-xl bg-rose-50 border border-rose-200"><div className="font-semibold text-sm mb-1 text-rose-700">⚠️ Yêu cầu</div><ul className="text-xs text-rose-600 space-y-1"><li>• Chrome/Edge (Web Speech API)</li><li>• Cấp quyền micro</li><li>• Nói rõ ràng, chậm rãi</li></ul></div></div><Button size="lg" onClick={st2} className="gap-2 bg-gradient-to-r from-cyan-500 to-blue-500 text-white"><Mic className="h-5 w-5"/>Bắt đầu</Button></Card>);
if(Pf==="result"){const pct=Math.round((sc/qs.length)*100);const pts=sc*10;const em=pct>=80?"🏆":pct>=60?"🎉":pct>=40?"💪":"📚";const ti=pct>=80?"Xuất sắc!":pct>=60?"Tốt lắm!":pct>=40?"Cố lên!":"Cần luyện thêm!";return(<Card className="p-8 flex flex-col items-center gap-6 text-center bg-gradient-to-br from-emerald-50 via-teal-50 to-cyan-50 border-0"><div className="text-7xl">{em}</div><div><h3 className="text-3xl font-bold mb-1">{ti}</h3></div><div className="text-6xl font-bold bg-gradient-to-r from-emerald-500 to-teal-500 bg-clip-text text-transparent">{sc}/{qs.length}</div><Badge variant="secondary" className="text-base px-4 py-1">{pct}%</Badge><div className="w-full p-4 rounded-2xl bg-white/70 border border-emerald-200"><div className="text-xs uppercase text-muted-foreground mb-1">Điểm chăm chỉ</div><div className="text-4xl font-bold bg-gradient-to-r from-emerald-500 to-teal-500 bg-clip-text text-transparent">+{pts}</div></div><div className="w-full space-y-2 text-left"><h4 className="font-semibold">📋 Chi tiết</h4>{rs.map((r,i)=>(<div key={i} className={`p-2 rounded-lg text-xs flex items-center gap-2 ${r.c?"bg-emerald-50":"bg-rose-50"}`}><span className="font-mono w-6">{i+1}.</span>{r.c?<CheckCircle2 className="h-4 w-4 text-emerald-500"/>:<XCircle className="h-4 w-4 text-rose-500"/>}<div className="flex-1"><div className="text-muted-foreground">Bạn nói: <span className="font-medium">{r.s}</span></div>{!r.c&&<div className="text-muted-foreground">Đáp án: <span className="font-medium">{r.e}</span></div>}</div></div>))}</div><div className="flex gap-3"><Button onClick={st2} className="gap-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white"><RotateCcw className="h-4 w-4"/>Làm lại</Button><Button variant="outline" onClick={()=>setPf("intro")} className="gap-2"><ChevronLeft className="h-4 w-4"/>Thoát</Button></div></Card>);}
const q=qs[cur];if(!q)return null;const ml=q.mode==="repeat"?"Nói theo mẫu":q.mode==="answer"?"Trả lời câu hỏi":"Tự do giao tiếp";const mc=q.mode==="repeat"?"bg-cyan-100 text-cyan-700":q.mode==="answer"?"bg-amber-100 text-amber-700":"bg-violet-100 text-violet-700";
return(<div className="flex flex-col gap-5"><div className="flex items-center justify-between gap-4"><button onClick={()=>setPf("intro")} className="text-sm text-muted-foreground hover:text-foreground flex items-center gap-1"><ChevronLeft className="h-4 w-4"/>Thoát</button><Badge variant="secondary">Câu {cur+1}/{qs.length}</Badge><Badge className={mc}>{ml}</Badge></div><Progress value={((cur+1)/qs.length)*100} className="h-1.5"/><Card className="p-6 md:p-8 flex flex-col items-center gap-4 bg-gradient-to-br from-cyan-50 to-blue-50 border-2 border-cyan-100"><div className="text-xs uppercase text-muted-foreground">{ml}</div><div className="flex items-center gap-3"><div className="text-4xl md:text-5xl font-bold">{q.prompt}</div><button onClick={()=>sp(q.prompt)} className="p-2 rounded-full bg-cyan-100 text-cyan-600 hover:bg-cyan-200"><Volume2 className="h-5 w-5"/></button></div><div className="text-sm italic text-muted-foreground">{q.promptPinyin}</div><div className="text-sm text-foreground/70">{q.promptVi}</div></Card><Card className={`p-8 flex flex-col items-center gap-4 border-2 ${il?"border-rose-400 bg-rose-50":"border-slate-200 bg-white"}`}>{il?(<><div className="relative"><div className="absolute inset-0 rounded-full bg-rose-400 animate-ping opacity-30"/><button onClick={spl} className="relative w-20 h-20 rounded-full bg-rose-500 text-white flex items-center justify-center shadow-lg"><MicOff className="h-8 w-8"/></button></div><div className="text-sm font-medium text-rose-600">🎧 Đang nghe...</div></>):(<><button onClick={sl} className="w-20 h-20 rounded-full bg-gradient-to-br from-cyan-500 to-blue-500 text-white flex items-center justify-center shadow-lg hover:scale-105 transition-transform"><Mic className="h-8 w-8"/></button><div className="text-sm font-medium text-muted-foreground">Bấm mic để nói</div></>)}{hr&&st&&st!=="__ERR__"&&(<div className="mt-4 p-4 rounded-xl bg-slate-50 border border-slate-200 w-full"><div className="text-xs uppercase text-muted-foreground mb-1">Bạn đã nói:</div><div className="text-lg font-medium">{st}</div></div>)}{st==="__ERR__"&&(<div className="mt-4 p-3 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-600">⚠️ Không truy cập được micro.</div>)}</Card>{hr&&st&&st!=="__ERR__"&&(<motion.div initial={{opacity:0,y:10}} animate={{opacity:1,y:0}} className="flex justify-center"><Button onClick={ha} size="lg" className="gap-2 bg-gradient-to-r from-cyan-500 to-blue-500 text-white">{cur+1>=qs.length?"Xem kết quả":"Câu tiếp theo"} →</Button></motion.div>)}</div>);}
