  { id: 130, han: "我家离公司很近", pinyin: "wǒjiā lí gōngsī hěn jìn", meaning: "Nhà tôi rất gần công ty", pos: "Danh từ", emoji: "", example: "我家离公司很近。", examplePinyin: "wǒjiā lí gōngsī hěn jìn。", exampleVi: "Nhà tôi rất gần công ty。", topic: "objects" },
  { id: 131, han: "我家离公司很远", pinyin: "wǒjiā lí gōngsī hěn yuǎn", meaning: "Nhà tôi rất xa công ty.", pos: "Danh từ", emoji: "", example: "我家离公司很远。", examplePinyin: "wǒjiā lí gōngsī hěn yuǎn。", exampleVi: "Nhà tôi rất xa công ty.。", topic: "objects" },
  { id: 132, han: "骑摩托车上班还是自行车", pinyin: "骑摩托车上班还是自行车", meaning: "Bạn đi làm bằng xe máy hay xe đạp?", pos: "Động từ", emoji: "", example: "骑摩托车上班还是自行车。", examplePinyin: "骑摩托车上班还是自行车。", exampleVi: "Bạn đi làm bằng xe máy hay xe đạp?。", topic: "objects" },
  { id: 133, han: "你不想去，就在家休息吧。", pinyin: "Nǐ bùxiǎng qù, jiù zàijiā xiūxí ba.", meaning: "Bạn không muốn đi, thì ở nhà nghỉ ngơi đi.", pos: "Động từ", emoji: "", example: "你不想去，就在家休息吧。。", examplePinyin: "Nǐ bùxiǎng qù, jiù zàijiā xiūxí ba.。", exampleVi: "Bạn không muốn đi, thì ở nhà nghỉ ngơi đi.。", topic: "objects" },
  { id: 134, han: "这儿的咖啡不错，就和咖啡吧。", pinyin: "Zhè'er de kāfēi bùcuò, jiù hé kāfēi ba.", meaning: "Cà phê ở đây ngon lắm, uống cà phê đi.", pos: "Tính từ", emoji: "", example: "这儿的咖啡不错，就和咖啡吧。。", examplePinyin: "Zhè'er de kāfēi bùcuò, jiù hé kāfēi ba.。", exampleVi: "Cà phê ở đây ngon lắm, uống cà phê đi.。", topic: "food" },
  { id: 135, han: "就做 bạn 爱吃的鱼吧 / 就做你爱吃的鱼吧", pinyin: "Jiù zuò nǐ ài chī de yú ba", meaning: "Thì làm món cá bạn thích ăn đi", pos: "Động từ", emoji: "", example: "就做 bạn 爱吃的鱼吧 / 就做你爱吃的鱼吧。", examplePinyin: "Jiù zuò nǐ ài chī de yú ba。", exampleVi: "Thì làm món cá bạn thích ăn đi。", topic: "food" },
  { id: 136, han: "你身体怎么样？", pinyin: "nǐ shēntǐ zěnme yàng?", meaning: "Sức khỏe của bạn thế nào?", pos: "Danh từ", emoji: "", example: "你身体怎么样？。", examplePinyin: "nǐ shēntǐ zěnme yàng?。", exampleVi: "Sức khỏe của bạn thế nào?。", topic: "adjectives" },
  { id: 137, han: "还好。这件衣服大吗？", pinyin: "Hái hǎo. Zhè jiàn yīfú dà ma?", meaning: "Cũng được. Chiếc áo này có lớn không?", pos: "Tính từ", emoji: "", example: "还好。这件衣服大吗？。", examplePinyin: "Hái hǎo. Zhè jiàn yīfú dà ma?。", exampleVi: "Cũng được. Chiếc áo này có lớn không?。", topic: "objects" },
  { id: 138, han: "还行，不太大", pinyin: "Hái xíng, bù tài dà", meaning: "Cũng được, không lớn lắm", pos: "Tính từ", emoji: "", example: "还行，不太大。", examplePinyin: "Hái xíng, bù tài dà。", exampleVi: "Cũng được, không lớn lắm。", topic: "objects" },
  { id: 139, han: "昨天的考试怎么样？", pinyin: "zuótiān de kǎoshì zěnme yàng?", meaning: "Kỳ thi ngày hôm qua thế nào?", pos: "Danh từ", emoji: "", example: "昨天的考试怎么样？。", examplePinyin: "zuótiān de kǎoshì zěnme yàng?。", exampleVi: "Kỳ thi ngày hôm qua thế nào?。", topic: "time" },
  { id: 140, han: "我觉得听喝说还可以", pinyin: "Wǒ juédé tīng hē shuō hái kěyǐ", meaning: "Tôi thấy nghe và nói cũng được", pos: "Động từ", emoji: "", example: "我觉得听喝说还可以。", examplePinyin: "Wǒ juédé tīng hē shuō hái kěyǐ。", exampleVi: "Tôi thấy nghe và nói cũng được。", topic: "objects" },
  { id: 141, han: "读 và 写不好 / 读和写不好", pinyin: "dú hé xiě bù hǎo", meaning: "đọc và viết không tốt", pos: "Động từ", emoji: "", example: "读 và 写不好 / 读和写不好。", examplePinyin: "dú hé xiě bù hǎo。", exampleVi: "đọc và viết không tốt。", topic: "objects" },
  { id: 142, han: "今天天气有点儿冷", pinyin: "jīntiān tiānqì yǒudiǎnr lěng", meaning: "Hôm nay thời tiết hơi lạnh", pos: "Tính từ", emoji: "", example: "今天天气有点儿冷。", examplePinyin: "jīntiān tiānqì yǒudiǎnr lěng。", exampleVi: "Hôm nay thời tiết hơi lạnh。", topic: "time" },
  { id: 143, han: "我昨天有点儿累", pinyin: "wǒ zuótiān yǒudiǎnr lèi", meaning: "Hôm qua tôi hơi mệt", pos: "Tính từ", emoji: "", example: "我昨天有点儿累。", examplePinyin: "wǒ zuótiān yǒudiǎnr lèi。", exampleVi: "Hôm qua tôi hơi mệt。", topic: "time" },
  { id: 144, han: "这件衣服有点大", pinyin: "zhè jiàn yīfú yǒudiǎn dà", meaning: "Chiếc áo này hơi lớn", pos: "Tính từ", emoji: "", example: "这件衣服有点大。", examplePinyin: "zhè jiàn yīfú yǒudiǎn dà。", exampleVi: "Chiếc áo này hơi lớn。", topic: "time" },
