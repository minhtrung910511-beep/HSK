  { id: 65, han: "王老师已经回家了", pinyin: "wáng lǎoshī yǐjīng huí jiāle", meaning: "cô vương đã về nhà rồi.", pos: "Danh từ", emoji: "", example: "王老师已经回家了。", examplePinyin: "wáng lǎoshī yǐjīng huí jiāle。", exampleVi: "cô vương đã về nhà rồi.。", topic: "people" },
  { id: 66, han: "我的身体已经很好了", pinyin: "wǒ de shēntǐ yǐjīng hěn hǎole", meaning: "Sức khỏe của tôi bây giờ rất tốt.", pos: "Tính từ", emoji: "", example: "我的身体已经很好了。", examplePinyin: "wǒ de shēntǐ yǐjīng hěn hǎole。", exampleVi: "Sức khỏe của tôi bây giờ rất tốt.。", topic: "time" },
  { id: 67, han: "我已经踢了十年了", pinyin: "wǒ yǐjīng tīle shí niánle", meaning: "Tôi đã chơi bóng đá được mười năm.", pos: "Danh từ", emoji: "", example: "我已经踢了十年了。", examplePinyin: "wǒ yǐjīng tīle shí niánle。", exampleVi: "Tôi đã chơi bóng đá được mười năm.。", topic: "time" },
  { id: 68, han: "上班的时候不可以玩手机", pinyin: "Shàngbān de shíhòu bù kěyǐ wán shǒujī", meaning: "trong giờ làm việc không được chơi điện thoại", pos: "Danh từ", emoji: "", example: "上班的时候不可以玩手机。", examplePinyin: "Shàngbān de shíhòu bù kěyǐ wán shǒujī。", exampleVi: "trong giờ làm việc không được chơi điện thoại。", topic: "time" },
  { id: 69, han: "吃饭的时候不应该说话", pinyin: "chīfàn de shíhòu bù yīnggāi shuōhuà", meaning: "Không nên nói chuyện trong khi ăn.", pos: "Động từ", emoji: "", example: "吃饭的时候不应该说话。", examplePinyin: "chīfàn de shíhòu bù yīnggāi shuōhuà。", exampleVi: "Không nên nói chuyện trong khi ăn.。", topic: "time" },
  { id: 70, han: "什么问题都有处理的方法", pinyin: "shén me wèntí dōu yǒu chǔlǐ de fāngfǎ", meaning: "Mọi vấn đề đều có cách giải quyết", pos: "Động từ", emoji: "", example: "什么问题都有处理的方法。", examplePinyin: "shén me wèntí dōu yǒu chǔlǐ de fāngfǎ。", exampleVi: "Mọi vấn đề đều có cách giải quyết。", topic: "food" },
  { id: 71, han: "幸运", pinyin: "xìngyùn", meaning: "May mắn", pos: "Danh từ", emoji: "", example: "幸运。", examplePinyin: "xìngyùn。", exampleVi: "May mắn。", topic: "verbs" },
