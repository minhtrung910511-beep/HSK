  { id: 73, han: "对不起我打错了", pinyin: "duìbùqǐ wǒ dǎ cuòle", meaning: "Xin lỗi, tôi gọi nhầm rồi.", pos: "Động từ", emoji: "", example: "对不起我打错了。", examplePinyin: "duìbùqǐ wǒ dǎ cuòle。", exampleVi: "Xin lỗi, tôi gọi nhầm rồi.。", topic: "greetings" },
  { id: 74, han: "您可以说慢一点吗？", pinyin: "nín kěyǐ shuō màn yīdiǎn ma？", meaning: "Bạn có thể nói chậm xíu được không?", pos: "Động từ", emoji: "", example: "您可以说慢一点吗？。", examplePinyin: "nín kěyǐ shuō màn yīdiǎn ma？。", exampleVi: "Bạn có thể nói chậm xíu được không?。", topic: "time" },
