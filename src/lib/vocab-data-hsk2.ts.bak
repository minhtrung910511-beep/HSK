  { id: 158, han: "事故", pinyin: "shìgù", meaning: "tai nạn", pos: "Danh từ", emoji: "", example: "事故。", examplePinyin: "shìgù。", exampleVi: "tai nạn。", topic: "body" },
  { id: 159, han: "故事", pinyin: "gùshì", meaning: "câu chuyện", pos: "Danh từ", emoji: "", example: "故事。", examplePinyin: "gùshì。", exampleVi: "câu chuyện。", topic: "verbs" },
  { id: 160, han: "营养", pinyin: "yíngyǎng", meaning: "dinh dưỡng", pos: "Danh từ", emoji: "", example: "营养。", examplePinyin: "yíngyǎng。", exampleVi: "dinh dưỡng。", topic: "verbs" },
  { id: 161, han: "中国人的餐桌礼仪", pinyin: "Zhōngguó rén de cānzhuō lǐyí", meaning: "phép lịch sự trên bàn ăn của người trung quốc", pos: "Danh từ", emoji: "", example: "中国人的餐桌礼仪。", examplePinyin: "Zhōngguó rén de cānzhuō lǐyí。", exampleVi: "phép lịch sự trên bàn ăn của người trung quốc。", topic: "objects" },
  { id: 162, han: "中国人无论在家还是在饭馆，多人聚餐时一般会坐圆形餐桌，这样大家都可以面对面。", pinyin: "Zhōngguó rén wúlùn zàijiā háishì zài fànguǎn, duō rén jùcān shí yībān huì zuò yuán xíng cānzhuō, Zhèyàng dàjiā dōu kěyǐ miànduìmiàn.", meaning: "Người Trung Quốc dù ở nhà hay ở nhà hàng, khi nhiều người tụ tập ăn uống thường sẽ ngồi bàn ăn tròn, như vậy mọi người đều có thể mặt đối mặt.", pos: "Động từ", emoji: "", example: "中国人无论在家还是在饭馆，多人聚餐时一般会坐圆形餐桌，这样大家都可以面对面。。", examplePinyin: "Zhōngguó rén wúlùn zàijiā háishì zài fànguǎn, duō rén jùcān shí yībān huì zuò yuán xíng cānzhuō, Zhèyàng dàjiā dōu kěyǐ miànduìmiàn.。", exampleVi: "Người Trung Quốc dù ở nhà hay ở nhà hàng, khi nhiều người tụ tập ăn uống thường sẽ ngồi bàn ăn tròn, như vậy mọi người đều có thể mặt đối mặt.。", topic: "time" },
  { id: 163, han: "在饭馆里人座的时候，主人的着手边 là 主客。左手边是次重要的人.", pinyin: "Zài fànguǎn lǐ rén zuò de shíhòu, zhǔrén de zhuóshǒu biān shì zhǔkè. Zuǒshǒu biān shì cì zhòngyào de rén.", meaning: "Khi ngồi vào chỗ trong nhà hàng, bên tay phải của chủ nhà là khách quý. Bên tay trái là người quan trọng thứ hai.", pos: "Danh từ", emoji: "", example: "在饭馆里人座的时候，主人的着手边 là 主客。左手边是次重要的人.。", examplePinyin: "Zài fànguǎn lǐ rén zuò de shíhòu, zhǔrén de zhuóshǒu biān shì zhǔkè. Zuǒshǒu biān shì cì zhòngyào de rén.。", exampleVi: "Khi ngồi vào chỗ trong nhà hàng, bên tay phải của chủ nhà là khách quý. Bên tay trái là người quan trọng thứ hai.。", topic: "people" },
  { id: 164, han: "主人对面上菜的位置一般不能给客人坐.", pinyin: "Zhǔrén duìmiàn shàng cài de wèizhì yībān bùnéng gěi kèrén zuò.", meaning: "Vị trí đối diện chủ nhà là nơi lên món ăn, thường không thể để cho khách ngồi.", pos: "Động từ", emoji: "", example: "主人对面上菜的位置一般不能给客人坐.。", examplePinyin: "Zhǔrén duìmiàn shàng cài de wèizhì yībān bùnéng gěi kèrén zuò.。", exampleVi: "Vị trí đối diện chủ nhà là nơi lên món ăn, thường không thể để cho khách ngồi.。", topic: "people" },
  { id: 165, han: "通过餐桌上的菜也可以分辨主客。如果有鱼", pinyin: "Tōngguò cānzhuō shàng de cài yě kěyǐ fēnbiàn zhǔkè. Rúguǒ yǒu yú", meaning: "Thông qua các món ăn trên bàn cũng có thể phân biệt khách quý. Nếu có cá", pos: "Danh từ", emoji: "", example: "通过餐桌上的菜也可以分辨主客。如果有鱼。", examplePinyin: "Tōngguò cānzhuō shàng de cài yě kěyǐ fēnbiàn zhǔkè. Rúguǒ yǒu yú。", exampleVi: "Thông qua các món ăn trên bàn cũng có thể phân biệt khách quý. Nếu có cá。", topic: "time" },
  { id: 166, han: "鱼头要对着最主要的客人，表示主人对客人的六尊重", pinyin: "Yú tóu yào duìzhe zuì zhǔyào de kèrén, biǎoshì zhữrén duì kèrén de liù zūnzhòng", meaning: "Đầu cá phải hướng về phía khách quan trọng nhất, thể hiện sự tôn trọng tuyệt đối của chủ nhà đối với khách", pos: "Tính từ", emoji: "", example: "鱼头要对着最主要的客人，表示主人对客人的六尊重。", examplePinyin: "Yú tóu yào duìzhe zuì zhǔyào de kèrén, biǎoshì zhữrén duì kèrén de liù zūnzhòng。", exampleVi: "Đầu cá phải hướng về phía khách quan trọng nhất, thể hiện sự tôn trọng tuyệt đối của chủ nhà đối với khách。", topic: "people" },
  { id: 167, han: "灰色", pinyin: "Huīsè", meaning: "Xám", pos: "Danh từ", emoji: "", example: "灰色。", examplePinyin: "Huīsè。", exampleVi: "Xám。", topic: "verbs" },
